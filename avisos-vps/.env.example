# Copia este archivo a ".env" y llena los valores

# URL de tu gestor (sin barra al final)
GESTOR_URL=https://gestor.clrcolorz.shop

# La MISMA clave secreta que pongas en Cloudflare (WA_KEY). Invéntala larga y aleatoria.
WA_KEY=

# Número del CHIP del bot que enviará los avisos: 52 + 1 + tus 10 dígitos, sin + ni espacios
WA_NUMBER=

# Hora del envío diario (formato cron, hora de México). 0 10 * * * = 10:00 am
SEND_CRON=0 10 * * *

# Pausa entre mensajes, en segundos (anti-baneo)
MIN_DELAY=20
MAX_DELAY=45

# Tu número principal: solo él puede usar los comandos y ahí te llegan las respuestas de los clientes
OWNER=

# Clave por si WhatsApp oculta tu número: manda ".soy CLAVE" al chip una vez
CMD_PIN=

# Reenviar a tu número lo que contesten los clientes (on/off)
FORWARD=on
